CONFIG__DB__URL=...
CONFIG__JWT__PRIVATE_KEY_PATH=...
CONFIG__JWT__PUBLIC_KEY_PATH=...
CONFIG__MAIL__USERNAME=...
CONFIG__MAIL__PASSWORD=...
CONFIG__MAIL__PROVIDER=smtp
