# false = no SMTP needed: register creates the account immediately, no code.
# true  = full flow: code is sent by email and confirmed in /auth/verify-email.
CONFIG__AUTH__EMAIL_VERIFICATION=false

# Demo switch: true = no real emails, fixed code from DEMO__CODE.
CONFIG__DEMO__ENABLED=false
CONFIG__DEMO__CODE=000000
CONFIG__DEMO__FALLBACK_ON_QUOTA=true

# Set secure=true on HTTPS (Vercel/Northflank).
CONFIG__COOKIE__SECURE=false
CONFIG__COOKIE__SAMESITE=lax

# Comma-separated origins, only if the frontend calls the API directly.
CONFIG__CORS__ORIGINS=

# Cloudflare Turnstile (optional, strongly recommended for public demos).
CONFIG__TURNSTILE__ENABLED=false
CONFIG__TURNSTILE__SECRET=

